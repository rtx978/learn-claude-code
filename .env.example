# API key for an OpenAI-compatible provider (required)
# Examples: Baishan, OpenAI, DeepSeek-compatible gateways, OpenRouter, etc.
OPENAI_API_KEY=sk-your-api-key

# Base URL for your provider (required for non-OpenAI endpoints)
# Baishan Zhisuan example:
OPENAI_BASE_URL=https://api.edgefn.net/v1

# Model ID (required)
# Baishan examples:
MODEL_ID=DeepSeek-R1-Distill-Qwen-14B
# MODEL_ID=DeepSeek-V3.2
# MODEL_ID=Qwen2.5-72B-Instruct
# MODEL_ID=GLM-5

# Backward-compatible aliases:
# The local compatibility layer also accepts ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL
# if you already have existing env files using those names.
